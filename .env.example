MCP_URL=https://mcp-hackathon.sherpaswealth.com/mcp
MCP_TOKEN=
LLM_PROXY_URL=https://llm-hackathon.sherpaswealth.com
TEAM_KEY=

# Copy to .env and fill in. .env is git-ignored: never commit real keys.

# --- Brain stage (owner: Samuel) ---
# Text model that writes the narration, through LLM_PROXY_URL with TEAM_KEY. Only used when you run
# `python -m finagent.narrator`; the pipeline reads the saved text in narrations/ and never calls it.
BRAIN_MODEL=gpt-5-mini
# Models for live answers in /ask (fast ones: an answer must arrive in a few seconds).
ASK_MODEL=deepseek-flash
ASK_FALLBACK_MODEL=gemini-3.5-flash-lite
# Optional. Model that transcribes a spoken question when ElevenLabs Scribe fails. Default: gemini-3.5-flash-lite
STT_FALLBACK_MODEL=
# Optional caps on live questions, so a shared link cannot spend the team's credits. Defaults: 40 and 30.
ASK_MAX_TURNS=
ASK_MAX_PER_MINUTE=
# Optional. Where the backend keeps the conversation history. Default: data/sessions (git-ignored)
SESSIONS_DIR=

# --- Voice stage (owner: David) ---
# edge = free Microsoft Edge neural voices (needs internet, no key) | mock = no audio
# eleven = ElevenLabs (better voice, billed per character): use it for the demo, not for every check.sh
VOICE_ENGINE=edge
# Optional. Defaults: es-ES-ElviraNeural (es) / en-US-EmmaMultilingualNeural (en)
VOICE_NAME=
# Optional. Speaking speed for edge-tts: +0% (default, natural pace), -5% (slower), +10% (faster)...
VOICE_RATE=

# --- ElevenLabs (VOICE_ENGINE=eleven) ---
# Personal ElevenLabs key: goes straight to ElevenLabs. Empty -> TEAM_KEY + LLM_PROXY_URL (team's $1.40).
ELEVENLABS_API_KEY=
# Optional. Defaults: Matilda (XrExE9yKIg1WjnnlVkGX), eleven_flash_v2_5, 6000 characters per run.
ELEVEN_VOICE_ID=
ELEVEN_MODEL=
ELEVEN_MAX_CHARS=
# Optional. Speech-to-text model for spoken questions (default scribe_v2) and the ElevenLabs audio cache folder.
ELEVEN_STT_MODEL=
VOICE_CACHE_DIR=
